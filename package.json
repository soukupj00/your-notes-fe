    "contract:pull": "rev=$(git -C ../ni-dip-be rev-parse --short HEAD) && mkdir -p src/contract && sed \"s/<unpublished>/$rev/\" ../ni-dip-be/src/contract/index.ts > src/contract/index.ts",
